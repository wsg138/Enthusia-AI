# Enthusia AI — example environment
#
# Copy to .env for local development. NEVER commit a real .env.
# ALL secret values below are placeholders. Real secrets are injected at
# deploy time only (Bloom panel / production environment) and are NEVER
# required to install, build, test, or run CI.

NODE_ENV=development

# --- Service identity ---
ENTHUSIA_SERVICE_NAME=enthusia-ai
ENTHUSIA_SERVICE_VERSION=0.1.0
ENTHUSIA_LOG_LEVEL=info

# --- Networking ---
ENTHUSIA_AI_GATEWAY_PORT=4100
ENTHUSIA_DISCORD_SHARD_COUNT=1

# --- Local inference runtime (§9.2) ---
ENTHUSIA_MODEL_DIR=./models
ENTHUSIA_INFERENCE_CONCURRENCY=2

# --- Local inference adapter (W03, @enthusia/inference-adapter) ---
ENTHUSIA_INFERENCE_BASE_URL=http://localhost:8080
# ENTHUSIA_INFERENCE_MODEL=
ENTHUSIA_INFERENCE_TIMEOUT_MS=120000
ENTHUSIA_INFERENCE_MAX_RETRIES=3
ENTHUSIA_INFERENCE_RETRY_BASE_DELAY_MS=500
ENTHUSIA_INFERENCE_RETRY_MAX_DELAY_MS=10000
ENTHUSIA_INFERENCE_MAX_CONTEXT_TOKENS=32768
ENTHUSIA_INFERENCE_MAX_OUTPUT_TOKENS=4096
ENTHUSIA_INFERENCE_HEALTH_TIMEOUT_MS=5000
# ENTHUSIA_INFERENCE_API_KEY=<redacted>

# --- Tool budgets (§78) ---
ENTHUSIA_TOOL_DEFAULT_TIMEOUT_MS=30000
ENTHUSIA_MAX_TOOL_CALLS_PER_TURN=10

# --- AI Gateway (W02) ---
# Comma-separated service API keys. Leave unset for local dev/tests (auth disabled with a warning).
# ENTHUSIA_GATEWAY_API_KEYS=service-key-1,service-key-2
# ENTHUSIA_GATEWAY_ALLOWED_SURFACES=discord,minecraft,ticket,staff
# ENTHUSIA_GATEWAY_ALLOWED_ACTOR_TYPES=player,staff,system,unknown
# ENTHUSIA_GATEWAY_RATE_LIMIT_USER_PER_MIN=20
# ENTHUSIA_GATEWAY_RATE_LIMIT_GLOBAL_PER_MIN=200
# ENTHUSIA_GATEWAY_MAX_MESSAGE_BYTES=8192
# ENTHUSIA_GATEWAY_MAX_BODY_BYTES=65536
# ENTHUSIA_GATEWAY_AGENT_TIMEOUT_MS=30000
# ENTHUSIA_GATEWAY_READY_PROBE_TIMEOUT_MS=5000
# Production gateway -> W12 agent-service link:
# ENTHUSIA_AGENT_BASE_URL=http://127.0.0.1:4200
# ENTHUSIA_AGENT_API_KEY=agent-service-key-placeholder

# --- Agent service (W12 production composition root) ---
# ENTHUSIA_AGENT_PORT=4200
# Comma-separated keys accepted from the AI Gateway. Required in production.
# ENTHUSIA_AGENT_API_KEYS=agent-service-key-placeholder
# ENTHUSIA_AGENT_MAX_BODY_BYTES=65536
# Optional strict JSON W09 live-source config. Contains references only, never credentials.
# ENTHUSIA_AGENT_SFTP_CONFIG_PATH=/run/enthusia-ai/live-sftp.json
# Each SFTP authRef names a runtime environment variable containing a JSON
# credential object injected by the deployment environment; never commit it.

# --- Optional integrations (leave unset for local dev/tests) ---
# ENTHUSIA_DATABASE_URL=postgres://<db-user>:<db-password>@localhost:5432/enthusia_ai
# ENTHUSIA_VECTOR_INDEX_URL=http://localhost:6333

# --- Discord bot surface (W06) ---
# Comma-separated channel/role IDs. All optional; with none set the bot only
# answers explicit mentions and /ai ask.
# ENTHUSIA_DISCORD_TEST_CHANNELS=
# ENTHUSIA_DISCORD_AI_CHANNELS=
# ENTHUSIA_DISCORD_STAFF_CHANNELS=
# ENTHUSIA_DISCORD_STAFF_ROLES=
# ENTHUSIA_DISCORD_BOT_NAME=Enthusia AI
# ENTHUSIA_AI_GATEWAY_URL=http://127.0.0.1:4100
# Mock mode is local/test only. Production must keep this false.
# ENTHUSIA_DISCORD_USE_MOCK_GATEWAY=false
# ENTHUSIA_DISCORD_GATEWAY_TIMEOUT_MS=30000
# ENTHUSIA_DISCORD_PER_USER_LIMIT=5
# ENTHUSIA_DISCORD_PER_USER_WINDOW_MS=60000
# ENTHUSIA_DISCORD_GLOBAL_LIMIT=60
# ENTHUSIA_DISCORD_GLOBAL_WINDOW_MS=60000
# Guild ID for fast guild-scoped /ai registration (unset = global).
# ENTHUSIA_DISCORD_SLASH_GUILD_ID=

# --- Secrets: placeholders only. NEVER put real values here. ---
# DISCORD_BOT_TOKEN=discord-bot-token-placeholder
# ENTHUSIA_AI_GATEWAY_API_KEY=ai-gateway-service-key-placeholder
# OPENAI_API_KEY=openai-api-key-placeholder
