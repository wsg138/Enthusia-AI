# =============================================================================
# Enthusia AI — resource limit defaults (TEMPLATE, W21 prepare-only).
#
# Copy into the Pterodactyl server's environment (or systemd EnvironmentFile)
# when a server is provisioned from the egg. Values are defaults only; the
# panel allocation is the enforcement point on Bloom.
#
# Rationale for every value lives in deploy/RESOURCE-LIMITS.md.
# Spec: MASTER-SPECIFICATION.md §§35.2–35.4, 63.
# =============================================================================

# --- Role: agent | discord | inference | indexer (one per server, §35.1) ---
AI_SERVICE=agent

# --- Memory: model server capped in the 24–32 GB initial envelope (§63) ---
MODEL_RAM_MAX_GB=28

# --- CPU: explicitly bounded; inference must not saturate all cores (§35.2) ---
INFERENCE_THREADS=8
INDEXER_THREADS=2
# Optional taskset list, e.g. "8-15". Empty = no pinning.
CPU_PIN=

# --- OOM: AI dies before SMP, moderation, or Ticket Bot (§35.4) ---
# Higher score = killed first. SMP-critical services keep the default (0).
OOM_SCORE_ADJ=500

# --- Observability (§36) ---
LOG_LEVEL=info
# Node services may expose metrics separately. llama.cpp /metrics shares HEALTH_PORT.
METRICS_PORT=9090
HEALTH_PORT=8080
# Raw llama.cpp binds to loopback by default. Use only a private/internal address
# when a separate container must reach it; never expose it directly to the public internet.
INFERENCE_BIND_HOST=127.0.0.1

# --- Version recorded at startup (§31, §36 startup version) ---
ENTHUSIA_VERSION=0.1.0-w21-template

# --- Secrets: NEVER put real values here (§34.1). Injected by the panel. ---
DISCORD_BOT_TOKEN=
ENTHUSIA_INFERENCE_API_KEY=
OPENAI_API_KEY=
DATABASE_URL=
